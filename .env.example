# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.

# --- Local development (DB on this PC) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=chat-cursor
DB_TEST_NAME=chat-cursor_test

# --- Docker / production (app on another PC, DB on DB PC) ---
# DB_HOST=192.168.0.10
# DB_CACHE_NAME=chat-cursor_cache
# DB_QUEUE_NAME=chat-cursor_queue
# DB_CABLE_NAME=chat-cursor_cable

# Rails credentials (copy from config/master.key)
RAILS_MASTER_KEY=

# Comma-separated hosts allowed to access the app (IP or domain, with optional port)
# Example: 192.168.0.20:3001,chat.example.com
APP_HOST=localhost:3001

# Action Cable WebSocket origins (full URLs, comma-separated)
# Example: http://192.168.0.20:3001,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001

# Docker only
SOLID_QUEUE_IN_PUMA=true
