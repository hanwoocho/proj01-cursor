# Copy this file to .env and fill in the missing values.
# .env is gitignored — never commit it.
#
# Target setup: app runs in Docker, PostgreSQL runs on a separate DB PC.
#   App PC : runs `docker compose up` (this image)
#   DB PC  : PostgreSQL reachable at DB_HOST below (currently 10.178.187.65)
#
# For local dev on the DB PC itself you may set DB_HOST=localhost.

# --- Database (PostgreSQL on DB PC) ---
DB_HOST=10.178.187.65
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=chat-cursor
DB_CACHE_NAME=chat-cursor_cache
DB_QUEUE_NAME=chat-cursor_queue
DB_CABLE_NAME=chat-cursor_cable
DB_TEST_NAME=chat-cursor_test

# Rails credentials key — paste the contents of config/master.key
RAILS_MASTER_KEY=

# Host(s) the app is reachable at (comma-separated, IP or domain with :port)
# Example: localhost:3001,10.178.187.220:3001
APP_HOST=localhost:3001,10.178.187.220:3001

# Action Cable WebSocket allowed origins (full URLs, comma-separated)
# Example: http://localhost:3001,http://10.178.187.220:3001
ALLOWED_ORIGINS=http://localhost:3001,http://10.178.187.220:3001

# Docker only
APP_PORT=3001
SOLID_QUEUE_IN_PUMA=true
